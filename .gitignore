# ------------------------------------------------------------
# Jupyter / JupyterLab
# ------------------------------------------------------------
# Unanchored on purpose: this project has checkpoints nested
# inside dataset/ and charts/ as well as at the repo root.
.ipynb_checkpoints/
.ipynb_checkpoints

# Editor scratch dir that mimics the .ipynb extension
.virtual_documents/

# Anaconda Navigator / JupyterLab Projects UI state (sqlite db)
anaconda_projects/
*.db
*.sqlite
*.sqlite3


# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Byte-compiled / optimized
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version


